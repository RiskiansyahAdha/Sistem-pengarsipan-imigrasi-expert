APP_NAME="Dashboard Statistik Umur"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=single
LOG_LEVEL=error

# Database SQLite: tidak perlu MySQL / XAMPP. File ada di database/database.sqlite
DB_CONNECTION=sqlite

# Tanpa server: session, cache, dan antrean disimpan di file / langsung dijalankan
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
